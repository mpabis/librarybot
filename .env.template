# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to git!

# Library account credentials
LIBRARY_USERNAME_1=your_first_card_number_here
LIBRARY_PASSWORD_1=your_first_pin_code_here

LIBRARY_USERNAME_2=your_second_card_number_here
LIBRARY_PASSWORD_2=your_second_pin_code_here

# Email configuration
MAILGUN_DOMAIN=your_mailgun_domain_here
MAILGUN_SENDER_EMAIL=your_sender_email_here
MAILGUN_API_KEY=your_mailgun_api_key_here
RECIPIENT_EMAIL=your_recipient_email_here

# Notification settings
NOTIFY_BEFORE_DUE_DAYS=2
NOTIFICATIONS_ENABLED=true
